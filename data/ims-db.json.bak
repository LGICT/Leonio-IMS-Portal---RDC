V6Z2Xr3zkvQL0Jj5a7DCdKj1eqF8Rr8kSqlOKY=","Salt":"EACSOwptVEen8q5dmoZnNg==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":11,"Username":"ptorres","Name":"Paolo Torres","Email":"ptorres@leonio.local","Role":"Employee","Bu":"SHP","Dept":"OPS","Position":"Second Officer","PasswordHash":"lzAOFCs7H+pqVxcich5mrNjslGNHBNqLczleHnp9Liw=","Salt":"9YFov/7AeprB97I0lKumlQ==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":12,"Username":"kvillanueva","Name":"Kristine Villanueva","Email":"kvillanueva@leonio.local","Role":"Employee","Bu":"MIN","Dept":"HSE","Position":"Site Safety Officer","PasswordHash":"j/CTSS1sqMLT5XKNEXIXh7+EuwmnfZ525nEqKSq+tnY=","Salt":"DWJBVcW2BMKry9RkZ5TL/w==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":13,"Username":"gaquino","Name":"Grace Aquino","Email":"gaquino@leonio.local","Role":"Employee","Bu":"LND","Dept":"FIN","Position":"Accounts Payable Specialist","PasswordHash":"+sxHJW9nbsqjmdlnmsLc/FA6E6RqNnbGSui2sy0O2YE=","Salt":"E14xe+o1zsFRCQ3szFOcYw==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":14,"Username":"jlim","Name":"Jerome Lim","Email":"jlim@leonio.local","Role":"Employee","Bu":"LND","Dept":"OPS","Position":"Site Supervisor","PasswordHash":"8wL2HIsgfp7e41qgNEjgXRX6de4D8geqZEyqwALVaKk=","Salt":"P9KGlUD25ZyrWLfitjudpw==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":15,"Username":"rdomingo","Name":"Rhea Domingo","Email":"rdomingo@leonio.local","Role":"Employee","Bu":"CORP","Dept":"FIN","Position":"Finance Analyst","PasswordHash":"wY0eNaTg9lhiKtDhsuFlD6ddCaZW8a5EN+fJriJ7i+M=","Salt":"WfaVNlUUrw5IupGDG7iWiA==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null}],"Documents":[{"Id":16,"DocNo":"GRP-QMS-POL-001","Title":"Integrated Management System Policy","Type":"POL","Bu":"GRP","Dept":"QMS","OwnerId":4,"ApproverId":3,"Standards":"ISO 9001:2015 5.2; ISO 14001:2015 5.2; ISO 45001:2018 5.2","Classification":"Internal","Process":"Leadership \u0026 Governance","ReviewMonths":24,"NextReviewDate":"2028-04-21","Status":"Effective","EffectiveRevisionId":18,"ObsoleteReason":null,"CreatedAt":"2025-03-17 09:00"},{"Id":33,"DocNo":"GRP-QMS-PRO-001","Title":"Document Control Procedure","Type":"PRO","Bu":"GRP","Dept":"QMS","OwnerId":4,"ApproverId":3,"Standards":"ISO 9001:2015 7.5; ISO 14001:2015 7.5; ISO 45001:2018 7.5","Classification":"Internal","Process":"IMS Document Control","ReviewMonths":24,"NextReviewDate":"2028-07-10","Status":"Effective","EffectiveRevisionId":35,"ObsoleteReason":null,"CreatedAt":"2025-06-05 09:00"},{"Id":47,"DocNo":"GRP-PRC-PRO-001","Title":"Procurement Procedure","Type":"PRO","Bu":"GRP","Dept":"PRC","OwnerId":5,"ApproverId":3,"Standards":"ISO 9001:2015 8.4","Classification":"Internal","Process":"Procure-to-Pay","ReviewMonths":24,"NextReviewDate":"2028-01-11","Status":"Effective","EffectiveRevisionId":50,"ObsoleteReason":null,"CreatedAt":"2024-12-07 09:00"},{"Id":63,"DocNo":"GRP-ICT-PRO-001","Title":"IT Access Management Procedure","Type":"PRO","Bu":"GRP","Dept":"ICT","OwnerId":6,"ApproverId":4,"Standards":"ISO/IEC 27001:2022 A.5.15-A.5.18","Classification":"Internal","Process":"ICT Service Management","ReviewMonths":12,"NextReviewDate":"2026-10-03","Status":"Effective","EffectiveRevisionId":65,"ObsoleteReason":null,"CreatedAt":"2024-08-29 09:00"},{"Id":81,"DocNo":"GRP-HR-PRO-001","Title":"Employee Onboarding Procedure","Type":"PRO","Bu":"GRP","Dept":"HR","OwnerId":7,"ApproverId":3,"Standards":"ISO 9001:2015 7.2, 7.3","Classification":"Internal","Process":"Hire-to-Retire","ReviewMonths":24,"NextReviewDate":"2028-09-23","Status":"Effective","EffectiveRevisionId":83,"ObsoleteReason":null,"CreatedAt":"2025-08-19 09:00"},{"Id":91,"DocNo":"GRP-QMS-PRO-002","Title":"Internal Audit Procedure","Type":"PRO","Bu":"GRP","Dept":"QMS","OwnerId":4,"ApproverId":3,"Standards":"ISO 9001:2015 9.2; ISO 19011:2018","Classification":"Internal","Process":"Performance Evaluation","ReviewMonths":24,"NextReviewDate":"2028-06-10","Status":"Effective","EffectiveRevisionId":93,"ObsoleteReason":null,"CreatedAt":"2025-05-06 09:00"},{"Id":103,"DocNo":"SHP-OPS-WI-001","Title":"Bunkering Operations Work Instruction","Type":"WI","Bu":"SHP","Dept":"OPS","OwnerId":9,"ApproverId":4,"Standards":"ISO 14001:2015 8.1, 8.2; MARPOL Annex I","Classification":"Internal","Process":"Vessel Operations","ReviewMonths":12,"NextReviewDate":"2027-09-08","Status":"Effective","EffectiveRevisionId":105,"ObsoleteReason":null,"CreatedAt":"2025-08-04 09:00"},{"Id":108,"DocNo":"MIN-HSE-WI-001","Title":"PPE Requirements at Mine Sites","Type":"WI","Bu":"MIN","Dept":"HSE","OwnerId":10,"ApproverId":4,"Standards":"ISO 45001:2018 8.1.2","Classification":"Internal","Process":"Site Safety","ReviewMonths":12,"NextReviewDate":"2027-10-18","Status":"Effective","EffectiveRevisionId":110,"ObsoleteReason":null,"CreatedAt":"2025-09-13 09:00"},{"Id":112,"DocNo":"GRP-PRC-FRM-001","Title":"Purchase Requisition Form","Type":"FRM","Bu":"GRP","Dept":"PRC","OwnerId":5,"ApproverId":3,"Standards":"ISO 9001:2015 8.4","Classification":"Internal","Process":"Procure-to-Pay","ReviewMonths":24,"NextReviewDate":"2028-01-11","Status":"Effective","EffectiveRevisionId":113,"ObsoleteReason":null,"CreatedAt":"2024-12-07 09:00"},{"Id":115,"DocNo":"GRP-HSE-PRO-001","Title":"Incident Reporting and Investigation Procedure","Type":"PRO","Bu":"GRP","Dept":"HSE","OwnerId":4,"ApproverId":3,"Standards":"ISO 45001:2018 10.2","Classification":"Internal","Process":"Incident Management","ReviewMonths":24,"NextReviewDate":null,"Status":"Draft","EffectiveRevisionId":0,"ObsoleteReason":null,"CreatedAt":"2026-11-04 09:00"}],"Revisions":[{"Id":17,"DocId":16,"Rev":"00","Status":"Superseded","Content":"# Purpose\nThis policy sets out Leonio Group\u0027s commitment to quality, environmental protection and occupational health and safety across all business units.\n\n# Policy statement\nLeonio Group commits to:\n- Deliver services that meet customer, legal and regulatory requirements.\n- Prevent work-related injury and ill health and provide safe and healthy workplaces.\n- Protect the environment, including prevention of pollution, at sea, at mine sites and on land.\n- Consult and involve workers and their representatives.\n- Set measurable objectives and continually improve the Integrated Management System (IMS).\n\n# Responsibilities\n- **Executive management** provides resources and reviews IMS performance at least annually.\n- **Business unit heads** implement this policy within their operations.\n- **All employees** follow approved procedures and report hazards, incidents and nonconformities.\n\n# Communication\nThis policy is published in the IMS Portal, displayed at all sites and vessels, and made available to interested parties on request.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2025-04-01 09:00","SubmittedBy":4,"SubmittedAt":"2025-04-11 09:00","ReviewedBy":3,"ReviewedAt":"2025-04-18 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-04-21","SupersededAt":"2026-04-21"},{"Id":18,"DocId":16,"Rev":"01","Status":"Effective","Content":"# Purpose\nThis policy sets out Leonio Group\u0027s commitment to quality, environmental protection and occupational health and safety across all business units.\n\n# Policy statement\nLeonio Group commits to:\n- Deliver services that meet customer, legal and regulatory requirements.\n- Prevent work-related injury and ill health and provide safe and healthy workplaces.\n- Protect the environment, including prevention of pollution, at sea, at mine sites and on land.\n- Consult and involve workers and their representatives.\n- Set measurable objectives and continually improve the Integrated Management System (IMS).\n\n# Responsibilities\n- **Executive management** provides resources and reviews IMS performance at least annually.\n- **Business unit heads** implement this policy within their operations.\n- **All employees** follow approved procedures and report hazards, incidents and nonconformities.\n\n# Communication\nThis policy is published in the IMS Portal, displayed at all sites and vessels, and made available to interested parties on request.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2026-04-01 09:00","SubmittedBy":4,"SubmittedAt":"2026-04-11 09:00","ReviewedBy":3,"ReviewedAt":"2026-04-18 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-04-21","SupersededAt":null},{"Id":34,"DocId":33,"Rev":"00","Status":"Superseded","Content":"# Purpose\nDefines how controlled documents are created, reviewed, approved, published, revised and withdrawn.\n\n# Scope\nAll policies, procedures, work instructions, forms and manuals of Leonio Group and its business units.\n\n# Document numbering\nDocuments are numbered **BU-DEPT-TYPE-NNN**, for example GRP-PRC-PRO-001.\n\n| Type | Code |\n|---|---|\n| Policy | POL |\n| Procedure | PRO |\n| Work Instruction | WI |\n| Form / Template | FRM |\n| Manual | MAN |\n\n# Procedure\n1. The document owner prepares a draft in the IMS Portal.\n2. The owner submits the draft to the designated approver. The preparer may not approve their own document.\n3. The approver approves the revision or returns it with comments.\n4. The IMS Document Controller publishes the approved revision. The previous revision is automatically superseded.\n5. Affected employees acknowledge that they have read the new revision.\n6. The owner reviews each document at least every 24 months.\n\n# Uncontrolled copies\nPrinted or downloaded copies are uncontrolled. Always confirm the current revision in the IMS Portal.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2025-06-20 09:00","SubmittedBy":4,"SubmittedAt":"2025-06-30 09:00","ReviewedBy":3,"ReviewedAt":"2025-07-07 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-07-10","SupersededAt":"2026-07-10"},{"Id":35,"DocId":33,"Rev":"01","Status":"Effective","Content":"# Purpose\nDefines how controlled documents are created, reviewed, approved, published, revised and withdrawn.\n\n# Scope\nAll policies, procedures, work instructions, forms and manuals of Leonio Group and its business units.\n\n# Document numbering\nDocuments are numbered **BU-DEPT-TYPE-NNN**, for example GRP-PRC-PRO-001.\n\n| Type | Code |\n|---|---|\n| Policy | POL |\n| Procedure | PRO |\n| Work Instruction | WI |\n| Form / Template | FRM |\n| Manual | MAN |\n\n# Procedure\n1. The document owner prepares a draft in the IMS Portal.\n2. The owner submits the draft to the designated approver. The preparer may not approve their own document.\n3. The approver approves the revision or returns it with comments.\n4. The IMS Document Controller publishes the approved revision. The previous revision is automatically superseded.\n5. Affected employees acknowledge that they have read the new revision.\n6. The owner reviews each document at least every 24 months.\n\n# Uncontrolled copies\nPrinted or downloaded copies are uncontrolled. Always confirm the current revision in the IMS Portal.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2026-06-20 09:00","SubmittedBy":4,"SubmittedAt":"2026-06-30 09:00","ReviewedBy":3,"ReviewedAt":"2026-07-07 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-07-10","SupersededAt":null},{"Id":48,"DocId":47,"Rev":"00","Status":"Superseded","Content":"# Purpose\nEnsures goods and services are purchased competitively, from approved suppliers, and within the approved Limits of Authority (LOA).\n\n# Procedure\n1. The requesting department raises a **Purchase Requisition** (GRP-PRC-FRM-001).\n2. The department head approves the requisition according to the LOA.\n3. Procurement obtains at least **three quotations** for purchases above PHP 50,000.\n4. Procurement evaluates quotations on price, quality, delivery and supplier performance.\n5. The Purchase Order is approved according to the LOA and issued to the supplier.\n6. The receiving department inspects and accepts delivered goods or services.\n\n# Approved suppliers\nOnly suppliers on the Approved Supplier List may be used, unless an exception is approved by the COO.\n\n# Records\nRequisitions, quotations, evaluations and purchase orders are retained for at least 10 years.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":5,"CreatedAt":"2023-12-23 09:00","SubmittedBy":5,"SubmittedAt":"2024-01-02 09:00","ReviewedBy":3,"ReviewedAt":"2024-01-09 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2024-01-12","SupersededAt":"2025-01-11"},{"Id":49,"DocId":47,"Rev":"01","Status":"Superseded","Content":"# Purpose\nEnsures goods and services are purchased competitively, from approved suppliers, and within the approved Limits of Authority (LOA).\n\n# Procedure\n1. The requesting department raises a **Purchase Requisition** (GRP-PRC-FRM-001).\n2. The department head approves the requisition according to the LOA.\n3. Procurement obtains at least **three quotations** for purchases above PHP 50,000.\n4. Procurement evaluates quotations on price, quality, delivery and supplier performance.\n5. The Purchase Order is approved according to the LOA and issued to the supplier.\n6. The receiving department inspects and accepts delivered goods or services.\n\n# Approved suppliers\nOnly suppliers on the Approved Supplier List may be used, unless an exception is approved by the COO.\n\n# Records\nRequisitions, quotations, evaluations and purchase orders are retained for at least 10 years.","ChangeSummary":"Added LOA references","FileId":null,"FileName":null,"FileType":null,"CreatedBy":5,"CreatedAt":"2024-12-22 09:00","SubmittedBy":5,"SubmittedAt":"2025-01-01 09:00","ReviewedBy":3,"ReviewedAt":"2025-01-08 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-01-11","SupersededAt":"2026-01-11"},{"Id":50,"DocId":47,"Rev":"02","Status":"Effective","Content":"# Purpose\nEnsures goods and services are purchased competitively, from approved suppliers, and within the approved Limits of Authority (LOA).\n\n# Procedure\n1. The requesting department raises a **Purchase Requisition** (GRP-PRC-FRM-001).\n2. The department head approves the requisition according to the LOA.\n3. Procurement obtains at least **three quotations** for purchases above PHP 50,000.\n4. Procurement evaluates quotations on price, quality, delivery and supplier performance.\n5. The Purchase Order is approved according to the LOA and issued to the supplier.\n6. The receiving department inspects and accepts delivered goods or services.\n\n# Approved suppliers\nOnly suppliers on the Approved Supplier List may be used, unless an exception is approved by the COO.\n\n# Records\nRequisitions, quotations, evaluations and purchase orders are retained for at least 10 years.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":5,"CreatedAt":"2025-12-22 09:00","SubmittedBy":5,"SubmittedAt":"2026-01-01 09:00","ReviewedBy":3,"ReviewedAt":"2026-01-08 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-01-11","SupersededAt":null},{"Id":61,"DocId":47,"Rev":"03","Status":"InReview","Content":"# Purpose\nEnsures goods and services are purchased competitively, from approved suppliers, and within the approved Limits of Authority (LOA).\n\n# Procedure\n1. The requesting department raises a **Purchase Requisition** (GRP-PRC-FRM-001).\n2. The department head approves the requisition according to the LOA.\n3. Procurement obtains at least **three quotations** for purchases above PHP 100,000.\n4. Procurement evaluates quotations on price, quality, delivery and supplier performance.\n5. The Purchase Order is approved according to the LOA and issued to the supplier.\n6. The receiving department inspects and accepts delivered goods or services.\n\n# Approved suppliers\nOnly suppliers on the Approved Supplier List may be used, unless an exception is approved by the COO.\n\n# Records\nRequisitions, quotations, evaluations and purchase orders are retained for at least 10 years.\n\n# Emergency purchases\nEmergency purchases for vessel or mine-site safety may proceed with one quotation, subject to approval by the BU head and documentation within 5 working days.","ChangeSummary":"Raised the three-quotation threshold to PHP 100,000 and added an emergency purchase provision.","FileId":null,"FileName":null,"FileType":null,"CreatedBy":5,"CreatedAt":"2026-11-01 09:00","SubmittedBy":5,"SubmittedAt":"2026-11-05 09:00","ReviewedBy":0,"ReviewedAt":null,"ReviewComment":null,"PublishedBy":0,"EffectiveDate":null,"SupersededAt":null},{"Id":64,"DocId":63,"Rev":"00","Status":"Superseded","Content":"# Purpose\nControls the granting, review and removal of access to Leonio Group information systems.\n\n# Procedure\n1. Access requests are raised through the ICT service desk and approved by the employee\u0027s department head.\n2. Access is granted on a least-privilege basis.\n3. HR notifies ICT of movers and leavers. Leaver access is removed **on the last working day**.\n4. Privileged accounts require multi-factor authentication.\n5. Department heads review user access every six months.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":6,"CreatedAt":"2024-09-13 09:00","SubmittedBy":6,"SubmittedAt":"2024-09-23 09:00","ReviewedBy":4,"ReviewedAt":"2024-09-30 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2024-10-03","SupersededAt":"2025-10-03"},{"Id":65,"DocId":63,"Rev":"01","Status":"Effective","Content":"# Purpose\nControls the granting, review and removal of access to Leonio Group information systems.\n\n# Procedure\n1. Access requests are raised through the ICT service desk and approved by the employee\u0027s department head.\n2. Access is granted on a least-privilege basis.\n3. HR notifies ICT of movers and leavers. Leaver access is removed **on the last working day**.\n4. Privileged accounts require multi-factor authentication.\n5. Department heads review user access every six months.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":6,"CreatedAt":"2025-09-13 09:00","SubmittedBy":6,"SubmittedAt":"2025-09-23 09:00","ReviewedBy":4,"ReviewedAt":"2025-09-30 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-10-03","SupersededAt":null},{"Id":82,"DocId":81,"Rev":"00","Status":"Superseded","Content":"# Purpose\nEnsures new employees are prepared, inducted and competent for their roles.\n\n# Procedure\n1. HR issues the onboarding checklist to the hiring manager at least 5 working days before the start date.\n2. ICT prepares accounts and equipment.\n3. On day one, the employee completes the IMS induction, including the IMS Policy and HSE rules.\n4. The hiring manager assigns role-specific procedures in the IMS Portal for acknowledgement.\n5. Competence is confirmed at the end of probation.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":7,"CreatedAt":"2025-09-03 09:00","SubmittedBy":7,"SubmittedAt":"2025-09-13 09:00","ReviewedBy":3,"ReviewedAt":"2025-09-20 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-09-23","SupersededAt":"2026-09-23"},{"Id":83,"DocId":81,"Rev":"01","Status":"Effective","Content":"# Purpose\nEnsures new employees are prepared, inducted and competent for their roles.\n\n# Procedure\n1. HR issues the onboarding checklist to the hiring manager at least 5 working days before the start date.\n2. ICT prepares accounts and equipment.\n3. On day one, the employee completes the IMS induction, including the IMS Policy and HSE rules.\n4. The hiring manager assigns role-specific procedures in the IMS Portal for acknowledgement.\n5. Competence is confirmed at the end of probation.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":7,"CreatedAt":"2026-09-03 09:00","SubmittedBy":7,"SubmittedAt":"2026-09-13 09:00","ReviewedBy":3,"ReviewedAt":"2026-09-20 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-09-23","SupersededAt":null},{"Id":92,"DocId":91,"Rev":"00","Status":"Superseded","Content":"# Purpose\nDefines how internal audits of the IMS are planned, conducted and reported.\n\n# Procedure\n1. The Management Systems Manager prepares an annual risk-based audit programme.\n2. Auditors are independent of the area audited.\n3. Findings are classified as **Major NC**, **Minor NC**, **Observation** or **Opportunity for Improvement**.\n4. Every nonconformity is recorded in the IMS Portal and a CAPA is raised with an owner and due date.\n5. The audit report is completed within 10 working days of the closing meeting.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2025-05-21 09:00","SubmittedBy":4,"SubmittedAt":"2025-05-31 09:00","ReviewedBy":3,"ReviewedAt":"2025-06-07 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-06-10","SupersededAt":"2026-06-10"},{"Id":93,"DocId":91,"Rev":"01","Status":"Effective","Content":"# Purpose\nDefines how internal audits of the IMS are planned, conducted and reported.\n\n# Procedure\n1. The Management Systems Manager prepares an annual risk-based audit programme.\n2. Auditors are independent of the area audited.\n3. Findings are classified as **Major NC**, **Minor NC**, **Observation** or **Opportunity for Improvement**.\n4. Every nonconformity is recorded in the IMS Portal and a CAPA is raised with an owner and due date.\n5. The audit report is completed within 10 working days of the closing meeting.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2026-05-21 09:00","SubmittedBy":4,"SubmittedAt":"2026-05-31 09:00","ReviewedBy":3,"ReviewedAt":"2026-06-07 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-06-10","SupersededAt":null},{"Id":104,"DocId":103,"Rev":"00","Status":"Superseded","Content":"# Purpose\nPrevents oil spills and injuries during bunkering.\n\n# Before bunkering\n1. Complete the bunkering safety checklist with the supplier.\n2. Plug all deck scuppers and prepare the SOPEP equipment.\n3. Agree on the transfer rate and the emergency stop signal.\n\n# During bunkering\n- Keep continuous watch at the manifold.\n- Monitor tank levels; top-off at reduced rate.\n\n# After bunkering\n- Drain and blank the hoses, and record quantities in the Oil Record Book.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":9,"CreatedAt":"2025-08-19 09:00","SubmittedBy":9,"SubmittedAt":"2025-08-29 09:00","ReviewedBy":4,"ReviewedAt":"2025-09-05 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-09-08","SupersededAt":"2026-09-08"},{"Id":105,"DocId":103,"Rev":"01","Status":"Effective","Content":"# Purpose\nPrevents oil spills and injuries during bunkering.\n\n# Before bunkering\n1. Complete the bunkering safety checklist with the supplier.\n2. Plug all deck scuppers and prepare the SOPEP equipment.\n3. Agree on the transfer rate and the emergency stop signal.\n\n# During bunkering\n- Keep continuous watch at the manifold.\n- Monitor tank levels; top-off at reduced rate.\n\n# After bunkering\n- Drain and blank the hoses, and record quantities in the Oil Record Book.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":9,"CreatedAt":"2026-08-19 09:00","SubmittedBy":9,"SubmittedAt":"2026-08-29 09:00","ReviewedBy":4,"ReviewedAt":"2026-09-05 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-09-08","SupersededAt":null},{"Id":109,"DocId":108,"Rev":"00","Status":"Superseded","Content":"# Minimum PPE in all operational areas\n- Hard hat, safety glasses and high-visibility vest\n- Steel-toed safety boots\n- Hearing protection where noise exceeds 85 dB(A)\n\n# Task-specific PPE\n| Task | Additional PPE |\n|---|---|\n| Blasting | Blast-rated hearing protection, face shield |\n| Working at height | Full-body harness with double lanyard |\n| Chemical handling | Chemical gloves and goggles |\n\nEmployees who are not wearing the required PPE must not enter operational areas.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":10,"CreatedAt":"2025-09-28 09:00","SubmittedBy":10,"SubmittedAt":"2025-10-08 09:00","ReviewedBy":4,"ReviewedAt":"2025-10-15 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2025-10-18","SupersededAt":"2026-10-18"},{"Id":110,"DocId":108,"Rev":"01","Status":"Effective","Content":"# Minimum PPE in all operational areas\n- Hard hat, safety glasses and high-visibility vest\n- Steel-toed safety boots\n- Hearing protection where noise exceeds 85 dB(A)\n\n# Task-specific PPE\n| Task | Additional PPE |\n|---|---|\n| Blasting | Blast-rated hearing protection, face shield |\n| Working at height | Full-body harness with double lanyard |\n| Chemical handling | Chemical gloves and goggles |\n\nEmployees who are not wearing the required PPE must not enter operational areas.","ChangeSummary":"Periodic review and update","FileId":null,"FileName":null,"FileType":null,"CreatedBy":10,"CreatedAt":"2026-09-28 09:00","SubmittedBy":10,"SubmittedAt":"2026-10-08 09:00","ReviewedBy":4,"ReviewedAt":"2026-10-15 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-10-18","SupersededAt":null},{"Id":113,"DocId":112,"Rev":"00","Status":"Effective","Content":"# Form fields\n- Requesting department and cost centre\n- Item description, specification and quantity\n- Estimated cost and budget reference\n- Required delivery date\n- Requested by / approved by (per LOA)\n\nUse the latest form from the IMS Portal. Older versions will not be accepted by Procurement.","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":5,"CreatedAt":"2025-12-22 09:00","SubmittedBy":5,"SubmittedAt":"2026-01-01 09:00","ReviewedBy":3,"ReviewedAt":"2026-01-08 09:00","ReviewComment":null,"PublishedBy":2,"EffectiveDate":"2026-01-11","SupersededAt":null},{"Id":116,"DocId":115,"Rev":"00","Status":"Draft","Content":"# Purpose\nDefines how incidents and near misses are reported and investigated.\n\n# Procedure\n1. Report every incident to the supervisor immediately.\n2. Record the incident in the IMS Portal within 24 hours.\n3. ...","ChangeSummary":"Initial issue","FileId":null,"FileName":null,"FileType":null,"CreatedBy":4,"CreatedAt":"2026-11-04 09:00","SubmittedBy":0,"SubmittedAt":null,"ReviewedBy":0,"ReviewedAt":null,"ReviewComment":null,"PublishedBy":0,"EffectiveDate":null,"SupersededAt":null}],"Acks":[{"Id":20,"RevisionId":18,"UserId":1,"At":"2026-11-06 09:00"},{"Id":21,"RevisionId":18,"UserId":2,"At":"2026-11-06 09:00"},{"Id":22,"RevisionId":18,"UserId":3,"At":"2026-11-06 09:00"},{"Id":23,"RevisionId":18,"UserId":4,"At":"2026-11-06 09:00"},{"Id":24,"RevisionId":18,"UserId":5,"At":"2026-11-06 09:00"},{"Id":25,"RevisionId":18,"UserId":6,"At":"2026-11-06 09:00"},{"Id":26,"RevisionId":18,"UserId":7,"At":"2026-11-06 09:00"},{"Id":27,"RevisionId":18,"UserId":8,"At":"2026-11-06 09:00"},{"Id":28,"RevisionId":18,"UserId":9,"At":"2026-11-06 09:00"},{"Id":29,"RevisionId":18,"UserId":10,"At":"2026-11-06 09:00"},{"Id":30,"RevisionId":18,"UserId":11,"At":"2026-11-06 09:00"},{"Id":31,"RevisionId":18,"UserId":12,"At":"2026-11-06 09:00"},{"Id":32,"RevisionId":18,"UserId":13,"At":"2026-11-06 09:00"},{"Id":37,"RevisionId":35,"UserId":1,"At":"2026-11-06 09:00"},{"Id":38,"RevisionId":35,"UserId":2,"At":"2026-11-06 09:00"},{"Id":39,"RevisionId":35,"UserId":3,"At":"2026-11-06 09:00"},{"Id":40,"RevisionId":35,"UserId":4,"At":"2026-11-06 09:00