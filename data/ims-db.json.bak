":"2026-11-06 09:00"},{"Id":89,"RevisionId":83,"UserId":5,"At":"2026-11-06 09:00"},{"Id":90,"RevisionId":83,"UserId":6,"At":"2026-11-06 09:00"},{"Id":95,"RevisionId":93,"UserId":1,"At":"2026-11-06 09:00"},{"Id":96,"RevisionId":93,"UserId":2,"At":"2026-11-06 09:00"},{"Id":97,"RevisionId":93,"UserId":3,"At":"2026-11-06 09:00"},{"Id":98,"RevisionId":93,"UserId":4,"At":"2026-11-06 09:00"},{"Id":99,"RevisionId":93,"UserId":5,"At":"2026-11-06 09:00"},{"Id":100,"RevisionId":93,"UserId":6,"At":"2026-11-06 09:00"},{"Id":101,"RevisionId":93,"UserId":7,"At":"2026-11-06 09:00"},{"Id":102,"RevisionId":93,"UserId":8,"At":"2026-11-06 09:00"},{"Id":107,"RevisionId":105,"UserId":9,"At":"2026-11-06 09:00"}],"Audits":[{"Id":118,"Ref":"IA-2026-001","Title":"Procure-to-Pay process audit","Standard":"ISO 9001:2015","Bu":"CORP","Dept":"PRC","Scope":"Requisition, quotation, PO approval and receiving","LeadAuditorId":8,"PlannedDate":"2026-09-28","Status":"Completed","Summary":"The procurement process is generally effective. Two nonconformities were raised on LOA compliance and use of obsolete forms.","CompletedAt":"2026-10-08","CreatedBy":8,"CreatedAt":"2026-09-08 09:00"},{"Id":129,"Ref":"IA-2026-002","Title":"Vessel operations and bunkering audit","Standard":"ISO 14001:2015; ISO 45001:2018","Bu":"SHP","Dept":"OPS","Scope":"Bunkering, spill response and permit-to-work on two vessels","LeadAuditorId":8,"PlannedDate":"2026-11-21","Status":"Planned","Summary":null,"CompletedAt":null,"CreatedBy":8,"CreatedAt":"2026-11-02 09:00"}],"Findings":[{"Id":119,"AuditId":118,"Ref":"IA-2026-001-F01","Type":"Minor NC","Clause":"8.4.1","Description":"3 of 25 sampled purchase orders above PHP 500,000 were approved by the Procurement Manager instead of the COO as required by the LOA.","Evidence":"PO-2026-0412, PO-2026-0519, PO-2026-0533","CapaId":122,"CreatedBy":8,"CreatedAt":"2026-09-30 09:00"},{"Id":120,"AuditId":118,"Ref":"IA-2026-001-F02","Type":"Minor NC","Clause":"7.5.3","Description":"Land BU is still using an obsolete version of the Purchase Requisition Form.","Evidence":"PR-LND-0088 and PR-LND-0091 used the 2023 form layout.","CapaId":123,"CreatedBy":8,"CreatedAt":"2026-09-30 09:00"},{"Id":121,"AuditId":118,"Ref":"IA-2026-001-F03","Type":"Opportunity for Improvement","Clause":"8.4.2","Description":"Supplier performance evaluation could be automated using delivery data from the ERP.","Evidence":null,"CapaId":0,"CreatedBy":8,"CreatedAt":"2026-09-30 09:00"}],"Capas":[{"Id":122,"Ref":"CAPA-2026-001","Source":"Internal Audit","FindingId":119,"Title":"IA-2026-001-F01: PO approvals not in line with LOA","Description":"3 of 25 sampled purchase orders above PHP 500,000 were approved by the Procurement Manager instead of the COO as required by the LOA.","Bu":"CORP","Dept":"PRC","OwnerId":5,"DueDate":"2026-11-27","RootCause":"The ERP approval matrix was not updated when the LOA was revised.","Correction":"The three POs were retroactively reviewed and ratified by the COO.","CorrectiveAction":null,"Evidence":null,"Status":"In Progress","VerifiedBy":0,"VerifiedAt":null,"VerificationComment":null,"CreatedBy":8,"CreatedAt":"2026-09-30 09:00","ClosedAt":null},{"Id":123,"Ref":"CAPA-2026-002","Source":"Internal Audit","FindingId":120,"Title":"IA-2026-001-F02: Obsolete requisition form in use","Description":"Land BU is still using an obsolete version of the Purchase Requisition Form.","Bu":"LND","Dept":"FIN","OwnerId":13,"DueDate":"2026-10-28","RootCause":null,"Correction":null,"CorrectiveAction":null,"Evidence":null,"Status":"Open","VerifiedBy":0,"VerifiedAt":null,"VerificationComment":null,"CreatedBy":8,"CreatedAt":"2026-09-30 09:00","ClosedAt":null},{"Id":124,"Ref":"CAPA-2026-003","Source":"Incident","FindingId":0,"Title":"Hydraulic oil leak during bunkering on MV Leonio Star","Description":"Approx. 5 litres of hydraulic oil spilled on deck; contained, no discharge overboard.","Bu":"SHP","Dept":"OPS","OwnerId":9,"DueDate":"2026-11-12","RootCause":"Worn hose coupling not identified because the pre-bunkering checklist had no hose inspection step.","Correction":"Spill cleaned up and hose replaced.","CorrectiveAction":"Hose inspection step added to the bunkering checklist; all vessels briefed.","Evidence":"Revised checklist and crew briefing attendance sheets for 6 vessels.","Status":"Pending Verification","VerifiedBy":0,"VerifiedAt":null,"VerificationComment":null,"CreatedBy":4,"CreatedAt":"2026-10-13 09:00","ClosedAt":null}],"Log":[{"Id":19,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":16,"Detail":"Rev 01 effective 2026-04-21 (migrated)"},{"Id":36,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":33,"Detail":"Rev 01 effective 2026-07-10 (migrated)"},{"Id":51,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":47,"Detail":"Rev 02 effective 2026-01-11 (migrated)"},{"Id":62,"At":"2026-11-07 23:48","UserId":5,"UserName":"Maria Reyes","Action":"Submitted for approval","Entity":"Document","EntityId":47,"Detail":"Rev 03 sent to Victor Navarro"},{"Id":66,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":63,"Detail":"Rev 01 effective 2025-10-03 (migrated)"},{"Id":84,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":81,"Detail":"Rev 01 effective 2026-09-23 (migrated)"},{"Id":94,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":91,"Detail":"Rev 01 effective 2026-06-10 (migrated)"},{"Id":106,"At":"2026-11-07 23:48","UserId":2,"UserName":"Ana Dela Cruz","Action":"Published revision","Entity":"Document","EntityId":103,"Detail":"Rev 01 effective 2026-09-08 (migrated)"},{"Id":111,"At":"2026-11-07 23:48","UserId":2,"UserName"