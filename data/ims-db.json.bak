{"Seq":137,"BusinessUnits":[{"Code":"GRP","Name":"Group-wide"},{"Code":"CORP","Name":"Corporate / Shared Services"},{"Code":"SHP","Name":"Shipping"},{"Code":"MIN","Name":"Mining"},{"Code":"LND","Name":"Land"}],"Departments":[{"Code":"ADM","Name":"Administration"},{"Code":"FIN","Name":"Finance"},{"Code":"HR","Name":"Human Resources"},{"Code":"HSE","Name":"Health, Safety \u0026 Environment"},{"Code":"ICT","Name":"Information \u0026 Communications Technology"},{"Code":"OPS","Name":"Operations"},{"Code":"PRC","Name":"Procurement"},{"Code":"QMS","Name":"Management Systems"}],"DocTypes":[{"Code":"POL","Name":"Policy"},{"Code":"PRO","Name":"Procedure"},{"Code":"WI","Name":"Work Instruction"},{"Code":"FRM","Name":"Form / Template"},{"Code":"MAN","Name":"Manual"}],"Users":[{"Id":1,"Username":"admin","Name":"System Administrator","Email":"admin@leonio.local","Role":"Admin","Bu":"CORP","Dept":"ICT","Position":"ICT Systems Administrator","PasswordHash":"leDZRUHNs2wVHkg963zdbyBesIaov61Rkb0YD3qfo0k=","Salt":"aay/rHnP8bCDtXX0oAWQnw==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":2,"Username":"dcontroller","Name":"Ana Dela Cruz","Email":"dcontroller@leonio.local","Role":"Controller","Bu":"CORP","Dept":"QMS","Position":"IMS Document Controller","PasswordHash":"zqTpxTubMbfH+A2ensGeYvluopeosYQGhpYSc1hMd9I=","Salt":"Bn5l8VUDfZDqTW8JNa/HUg==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":3,"Username":"vnavarro","Name":"Victor Navarro","Email":"vnavarro@leonio.local","Role":"Contributor","Bu":"CORP","Dept":"ADM","Position":"Chief Operating Officer","PasswordHash":"VTV2QRCis+k17Y2vhoXx2givUTvRlBPpJIa6wClUYsE=","Salt":"Pw0yGj5M+DCvTXT6U6iA7g==","Active":true,"MustChangePassword":false,"FailedLogins":0,"LockedUntil":null},{"Id":4,"Username":"jsantos","Name":"Jose Santos","Email":"jsantos@leonio.local","Role":"Contributor","Bu":"CORP","Dept":"QMS","Position":"Management Systems Manager","PasswordHash":"Xai+Dr5bmK+VW